<Window x:Class="ScreenRecorder.Views.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回放" Height="620" Width="900"
        WindowStartupLocation="CenterScreen" Background="#111827"
        FontFamily="Microsoft YaHei" Loaded="Window_Loaded" Closed="Window_Closed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player" Grid.Row="0" LoadedBehavior="Manual"
                      UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="Player_MediaFailed"/>

        <Border Grid.Row="1" Background="#1F2937" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPlay" Content="暂停" Width="84" Height="34" Margin="0,0,10,0"
                        Click="BtnPlay_Click" Background="#2C6BED" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnReplay" Content="重播" Width="84" Height="34" Margin="0,0,10,0"
                        Click="BtnReplay_Click" Background="#374151" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                <TextBlock x:Name="TxtFile" Text="" Foreground="#9CA3AF" FontSize="12"
                           VerticalAlignment="Center" MaxWidth="480" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
