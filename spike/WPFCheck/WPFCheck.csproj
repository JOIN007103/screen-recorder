<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWinRT 生成器集成：官方支持路径 -->
    <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
    <CsWinRTIncludes>Windows.Graphics.Capture;Windows.Graphics.DirectX.Direct3D11;Windows.Graphics.DirectX</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.0.4" />
  </ItemGroup>

</Project>
